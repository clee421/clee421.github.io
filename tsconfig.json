{
  "compilerOptions": {
    "baseUrl": "./src",
    "paths": {},
    "target": "es2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "module": "commonjs",
    "noImplicitAny": true,
    "outDir": "dist",
    "sourceMap": true,
    "jsx": "react",
    "esModuleInterop": true
  },
  "include": [
    "src/**/*",
    "type/*",
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "eslint.config.js",
    "webpack.common.js",
    "webpack.dev.js",
    "webpack.prod.js"
  ]
}